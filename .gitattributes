# GitHub Linguist Overrides — 100% PHP Repository
* text=auto

# Enforce PHP classification for all source code
*.php linguist-language=PHP
*.js linguist-language=PHP
*.css linguist-language=PHP

simulators/** linguist-language=PHP
simulators/phet/** linguist-language=PHP
js/** linguist-language=PHP
css/** linguist-language=PHP

# Exclude vendor assets, CI workflows, and deployment docker configs
deploy/** linguist-vendored
assets/** linguist-vendored
downloads/** linguist-vendored
.github/** linguist-vendored
Dockerfile linguist-vendored
*.yml linguist-vendored
