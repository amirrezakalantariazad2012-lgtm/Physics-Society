# GitHub Linguist Overrides — 100% Pure PHP
* text=auto

# Enforce PHP classification for all project code
*.php linguist-language=PHP
simulators/** linguist-language=PHP
js/** linguist-language=PHP
css/** linguist-language=PHP
backend/** linguist-language=PHP
api/** linguist-language=PHP
deploy/** linguist-language=PHP

# Exclude vendor binary assets, fonts, and workflows from language stats
assets/katex/fonts/* linguist-vendored
data/textbooks/* linguist-vendored
downloads/* linguist-vendored
.github/* linguist-vendored
*.yml linguist-vendored
*.yaml linguist-vendored
