# ============================================================
# PHYSICS ASSOCIATION EDUCATIONAL PLATFORM — ENVIRONMENT CONFIG
# دبیرستان استعدادهای درخشان شهید بهشتی ۲
# ============================================================

# Security & Sessions
SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local dev: sqlite:///./physics_platform.db
# Linux VPS Docker: postgresql+psycopg2://physics_user:secure_password_here@postgres:5432/physics_db
DATABASE_URL=sqlite:///./physics_platform.db

# Initial Admin Setup (Used ONLY during initial setup/CLI creation)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@beheshti2-physics.ir
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password

# AI Provider Settings (Configurable via Admin UI or Environment)
# Supported providers: openai, openrouter, deepseek, ollama, mock
AI_PROVIDER=mock
AI_API_KEY=your-ai-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TUTORING_MODEL=gpt-4o-mini
AI_GRADING_MODEL=gpt-4o-mini
AI_GENERATION_MODEL=gpt-4o-mini
AI_EXPLANATION_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2

# Application Settings
APP_NAME=سامانه جامع انجمن فیزیک دبیرستان شهید بهشتی ۲
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://physics.beheshti2.ir

# File Storage
UPLOAD_DIR=./data/uploads
TEXTBOOK_DIR=./data/textbooks
MAX_UPLOAD_SIZE_MB=50
