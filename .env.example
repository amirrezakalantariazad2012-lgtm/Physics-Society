# ============================================================
# QUANTUM CUT — ENVIRONMENT CONFIGURATION TEMPLATE
# انجمن فیزیک و المپیاد دبیرستان استعدادهای درخشان شهید بهشتی ۲
# ============================================================

# Security & Sessions
SECRET_KEY=replace-with-a-secure-random-64-char-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PHP PDO)
# SQLite (Default zero-config): sqlite:physics_platform.db
# MySQL / MariaDB (Production): mysql:host=127.0.0.1;port=3306;dbname=physics_society;charset=utf8mb4
DATABASE_URL=sqlite:physics_platform.db
DB_USER=
DB_PASS=

# Initial Admin Setup
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@beheshti2-physics.ir
INITIAL_ADMIN_PASSWORD=replace-with-strong-admin-password

# AI Provider Settings (Configured with Inferbase.ai & GPT Oss 120B)
# Supported providers: inferbase, openai, openrouter, deepseek, ollama, mock
AI_PROVIDER=inferbase
AI_API_KEY=your_inferbase_api_key_here
AI_BASE_URL=https://api.inferbase.ai/v1
AI_MODEL=openai-gpt-oss-120b
AI_MODEL_DISPLAY=GPT Oss 120B
AI_TUTORING_MODEL=openai-gpt-oss-120b
AI_GRADING_MODEL=openai-gpt-oss-120b
AI_GENERATION_MODEL=openai-gpt-oss-120b
AI_EXPLANATION_MODEL=openai-gpt-oss-120b
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.3

# Application Settings
APP_NAME=QUANTUM CUT — انجمن فیزیک سمپاد
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# File Storage
UPLOAD_DIR=./data/uploads
TEXTBOOK_DIR=./data/textbooks
MAX_UPLOAD_SIZE_MB=50
