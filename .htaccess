# QUANTUM CUT — Apache/LiteSpeed Server Configuration (cPanel/DirectAdmin 100% PHP Ready)

# Deny access to hidden files, storage artefacts and private application folders
<FilesMatch "(^\\.|\\.env|\\.db|\\.sqlite|\\.sql|\\.log|\\.ini|\\.bak|\\.sh|composer\\.(json|lock)|package(-lock)?\\.json)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Private directories are never web-accessible
    RewriteRule ^(?:\.git|\.backup|\.github|backend|data|deploy)(?:/|$) - [F,L]

    # Pass Authorization header to PHP in Apache / FastCGI / cPanel environments
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # Route all /api/* requests to api/index.php
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

    # Stream uploaded study materials through the PHP gateway (no direct storage access)
    RewriteRule ^uploads/(.+)$ uploads.php?f=$1 [L,QSA]

    # Rewrite any legacy .html simulator request to .php
    RewriteRule ^simulators/(.+)\.html$ simulators/$1.php [L,QSA]

    # Rewrite legacy .js or .css requests to .php if the corresponding .php file exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]

    # Serve existing files directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback to SPA entrypoint for client-side routing
    RewriteRule ^ index.php [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Correct MIME Types
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType application/vnd.android.package-archive .apk
</IfModule>
